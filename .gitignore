# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Local environment/config secrets
.env
.env.*
!.env.example

# macOS/editor noise
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Generated outputs and local processing artifacts
data/output/*
!data/output/.gitkeep

# Medical/source documents are local-only and should not be committed
data/input/*
!data/input/.gitkeep
!data/input/README.md

# Locally reviewed fixtures may contain PHI; keep templates only in git
tests/fixtures/*_expected.json
!tests/fixtures/*.example.json
!tests/fixtures/README.md
